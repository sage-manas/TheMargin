# The API reads these from the environment (it does not load .env files).
DATABASE_URL=postgresql://margin:margin@localhost:5432/margin
# Wiped by `pnpm api:test`. Never point it at a database you care about.
TEST_DATABASE_URL=postgresql://margin:margin@localhost:5432/margin_test
PORT=4000
# Site origins allowed for CORS and the CSRF Origin check (comma-separated).
WEB_ORIGINS=http://localhost:3000
# Only for plain-http local development.
COOKIE_SECURE=false
# Reverse-proxy hops to trust for the client IP (rate limits).
TRUST_PROXY=0
# Per-IP per-minute limits (defaults 120 / 5 / 10). Raise only for tests.
# RATE_LIMIT_DEFAULT=120
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_LOGIN=10
