{
  "name": "@the-margin/api",
  "version": "0.1.0",
  "private": true,
  "description": "The API: auth, cloud saves, progression, achievements, settings.",
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && swc src -d dist --strip-leading-paths --copy-files",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning dist/seed.js",
    "test": "pnpm build && node test/run.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@the-margin/contracts": "workspace:*",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.13.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "5.8.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22"
  }
}
