# Base URL of a Godot web export folder (containing build.json). Defaults to
# /game, which is proxied to GAME_DEV_ORIGIN (the static export server).
NEXT_PUBLIC_GAME_BUILD_URL=/game
GAME_DEV_ORIGIN=http://localhost:8060
# The API's base URL. Defaults to /v1, which is proxied to API_DEV_ORIGIN.
NEXT_PUBLIC_API_URL=/v1
API_DEV_ORIGIN=http://localhost:4000
